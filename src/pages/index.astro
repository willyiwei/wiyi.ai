---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- ═══════════════════════════════════════
       NAVIGATION
  ═══════════════════════════════════════ -->
  <nav
    id="main-nav"
    class="fixed top-0 left-0 right-0 z-50 transition-all duration-500"
    style="font-family: 'Outfit', sans-serif;"
  >
    <div class="max-w-7xl mx-auto px-8 lg:px-16 py-6 flex items-center justify-between">
      <!-- Monogram -->
      <a
        href="#hero"
        class="text-xl tracking-tight"
        style="font-family: 'Cormorant Garamond', serif; font-weight: 400; color: #FAFAFA;"
      >
        W<span style="color: #D4A017;">Y</span>
      </a>

      <!-- Links -->
      <div class="hidden md:flex items-center gap-8">
        {[
          { href: '#about', label: 'About' },
          { href: '#work', label: 'Work' },
          { href: '#projects', label: 'Projects' },
          { href: '#interests', label: 'Interests' },
        ].map(({ href, label }) => (
          <a
            href={href}
            class="nav-link text-sm transition-colors duration-200"
            style="color: #b0b0b0; letter-spacing: 0.04em;"
            onmouseover="this.style.color='#FAFAFA'"
            onmouseout="this.style.color='#b0b0b0'"
          >
            {label}
          </a>
        ))}
        <a
          href="#contact"
          class="btn-ghost text-sm"
          style="padding: 0.5rem 1.25rem;"
        >
          Connect
        </a>
      </div>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden flex flex-col gap-1.5 p-2"
        aria-label="Menu"
        onclick="document.getElementById('mobile-menu').classList.toggle('hidden')"
      >
        <span class="w-6 h-px block" style="background: #FAFAFA;"></span>
        <span class="w-4 h-px block" style="background: #FAFAFA;"></span>
        <span class="w-6 h-px block" style="background: #FAFAFA;"></span>
      </button>
    </div>

    <!-- Mobile menu -->
    <div
      id="mobile-menu"
      class="hidden md:hidden px-8 pb-6 flex flex-col gap-4"
      style="background: rgba(17, 17, 17, 0.95); backdrop-filter: blur(16px);"
    >
      {['About', 'Work', 'Projects', 'Interests', 'Contact'].map((label) => (
        <a
          href={`#${label.toLowerCase()}`}
          class="text-sm py-2 border-b"
          style="color: #b0b0b0; border-color: rgba(250,250,250,0.08);"
          onclick="document.getElementById('mobile-menu').classList.add('hidden')"
        >
          {label}
        </a>
      ))}
    </div>
  </nav>


  <!-- ═══════════════════════════════════════
       HERO
  ═══════════════════════════════════════ -->
  <section
    id="hero"
    class="relative min-h-screen flex flex-col justify-center overflow-hidden grain"
    style="padding-top: 6rem; padding-bottom: 6rem;"
  >
    <!-- Starfield canvas -->
    <canvas
      id="starfield"
      class="absolute inset-0 z-0"
      style="pointer-events: none;"
    ></canvas>

    <!-- Nebula gradient layers -->
    <div
      class="absolute inset-0 z-0"
      style="background:
        radial-gradient(ellipse at 75% 25%, rgba(212, 160, 23, 0.08) 0%, transparent 55%),
        radial-gradient(ellipse at 15% 65%, rgba(212, 160, 23, 0.05) 0%, transparent 50%),
        radial-gradient(ellipse at 50% 90%, rgba(212, 160, 23, 0.06) 0%, transparent 45%),
        radial-gradient(ellipse at 90% 80%, rgba(212, 160, 23, 0.04) 0%, transparent 40%),
        #111111;"
    ></div>

    <!-- Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-8 lg:px-16 w-full">
      <!-- Role label -->
      <div class="reveal reveal-d1 flex items-center gap-4 mb-8">
        <div class="rule-gold" style="width: 2.5rem;"></div>
        <span class="section-label" style="color: #D4A017;">
          Engineering Leader &nbsp;·&nbsp; Security Professional &nbsp;·&nbsp; Distance Runner
        </span>
      </div>

      <!-- Name — the centerpiece -->
      <h1
        class="reveal reveal-d2"
        style="
          font-family: 'Cormorant Garamond', serif;
          font-size: clamp(4.5rem, 13vw, 10.5rem);
          font-weight: 400;
          line-height: 0.88;
          letter-spacing: -0.02em;
          color: #FAFAFA;
          margin: 0 0 2rem;
        "
      >
        Will Yi
      </h1>

      <!-- Tagline + location row -->
      <div class="reveal reveal-d3 flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12">
        <p
          style="
            font-family: 'Outfit', sans-serif;
            font-size: clamp(1rem, 2vw, 1.25rem);
            font-weight: 300;
            color: #b0b0b0;
            max-width: 38rem;
            line-height: 1.65;
            margin: 0;
          "
        >
          Securing AI infrastructure. Leading with intent.<br />Always learning by doing.<br />
          Engineering Manager at Cisco.
        </p>

        <!-- Location badge -->
        <div
          class="flex items-center gap-2 shrink-0"
          style="font-family: 'JetBrains Mono', monospace; font-size: 0.72rem; color: #D4A017; letter-spacing: 0.12em;"
        >
          <span style="width: 6px; height: 6px; border-radius: 50%; background: #9C6B30; display: inline-block;"></span>
          SEATTLE, WA
        </div>
      </div>

      <!-- CTAs -->
      <div class="reveal reveal-d4 flex flex-wrap gap-4 items-center">
        <a href="#work" class="btn-gold">Explore My Work</a>
        <a href="#contact" class="btn-ghost">Let's Connect →</a>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div
      class="absolute bottom-10 right-10 hidden md:flex flex-col items-center gap-3"
      style="opacity: 0.3;"
    >
      <span
        style="
          font-family: 'JetBrains Mono', monospace;
          font-size: 0.65rem;
          letter-spacing: 0.18em;
          color: #FAFAFA;
          writing-mode: vertical-rl;
        "
      >SCROLL</span>
      <div style="width: 1px; height: 4rem; background: linear-gradient(to bottom, #E7DED1, transparent);"></div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════
       ABOUT
  ═══════════════════════════════════════ -->
  <section
    id="about"
    class="relative py-32"
    style="background: #0a0a0a;"
  >
    <div class="max-w-7xl mx-auto px-8 lg:px-16">
      <!-- Section header -->
      <div class="reveal flex items-center gap-4 mb-20">
        <span class="section-label">01 / About</span>
        <div style="flex: 1; height: 1px; background: rgba(250,250,250,0.1);"></div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-start">
        <!-- Left: big statement -->
        <div>
          <h2
            class="reveal"
            style="
              font-family: 'Cormorant Garamond', serif;
              font-size: clamp(2.2rem, 4.5vw, 3.5rem);
              font-weight: 600;
              line-height: 1.15;
              letter-spacing: -0.01em;
              color: #FAFAFA;
              margin: 0 0 2rem;
            "
          >
            Endlessly curious.<br />
            <span style="color: #D4A017; font-style: italic;">Selectively rigorous.</span><br />
            Always securing.
          </h2>

          <div class="rule-gold reveal reveal-d1" style="width: 3rem; margin-bottom: 2rem;"></div>

          <!-- Stats row -->
          <div class="reveal reveal-d2 grid grid-cols-3 gap-6 mb-12">
            {[
              { value: '18+', label: 'Years in Tech' },
              { value: '10+', label: 'Years Leadership' },
              { value: 'Orchestrator', label: 'Leadership Style' },
            ].map(({ value, label }) => (
              <div>
                <div
                  style="
                    font-family: 'Cormorant Garamond', serif;
                    font-size: 2.2rem;
                    font-weight: 300;
                    color: #D4A017;
                    line-height: 1;
                    margin-bottom: 0.35rem;
                  "
                >
                  {value}
                </div>
                <div style="font-size: 0.75rem; color: #b8a894; letter-spacing: 0.06em;">{label}</div>
              </div>
            ))}
          </div>
        </div>

        <!-- Right: bio -->
        <div class="reveal reveal-d1 flex flex-col gap-5" style="color: #b8a894; font-size: 1rem; line-height: 1.8;">
          <h3 style="font-family: 'Cormorant Garamond', serif; font-size: 1.5rem; font-weight: 400; color: #E7DED1; line-height: 1.2; margin: 0 0 0.5rem;">
            Engineering Manager | AI, Cloud & Infrastructure Security
          </h3>
          <p>
            I am an Engineering Manager at Cisco based in the Greater Seattle Area, specializing in building secure,
            intelligent infrastructure and services. With a deep foundation in product and cloud security,
            I focus on architecting resilient systems, implementing robust AI security frameworks,
            and empowering engineering teams to deliver high-impact, secure-by-default outcomes.
          </p>
          <h3 style="font-family: 'Cormorant Garamond', serif; font-size: 1.5rem; font-weight: 400; color: #E7DED1; line-height: 1.2; margin: 0 0 0.5rem;">
            My Approach
          </h3>
          <p>
            My leadership is grounded in pragmatism: I prioritize mentorship over directives and deliberate execution over noise,
            always maintaining a strict balance between rapid innovation and hardening production infrastructure.
            I focus on embedding secure-by-default principles into the development lifecycle,
            actively integrating secure agentic AI workflows into daily operations to optimize team velocity.
            For me, practice is where knowledge becomes skill—whether threat modeling a cloud pipeline or refining engineering strategies,
            true expertise is forged through execution.
          </p>
          <h3 style="font-family: 'Cormorant Garamond', serif; font-size: 1.5rem; font-weight: 400; color: #E7DED1; line-height: 1.2; margin: 0 0 0.5rem;">
            Beyond the Architecture
          </h3>
          <p>
            When I'm not securing infrastructure or optimizing workflows, you can find me logging miles on long-distance runs,
            playing guitar, or out on the golf course and badminton courts.
          </p>
          <p>
            Practice is where knowledge becomes skill. That applies to code, leadership, and everything else.
          </p>

          <div class="flex flex-wrap gap-3 mt-4">
            {['AI/LLM Engineering', 'Agentic Architectures', 'Engineering Leadership', 'Project Management', 'Data Analytics', 'Cloud Computing', 'Software Development', 'Network Security'].map((tag) => (
              <span
                style="
                  font-family: 'JetBrains Mono', monospace;
                  font-size: 0.68rem;
                  letter-spacing: 0.08em;
                  color: #D4A017;
                  border: 1px solid rgba(212, 160, 23, 0.25);
                  padding: 0.3rem 0.75rem;
                  border-radius: 1px;
                "
              >
                {tag}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════
       WORK / EXPERIENCE
  ═══════════════════════════════════════ -->
  <section
    id="work"
    class="relative py-32"
    style="background: #111111;"
  >
    <div class="max-w-7xl mx-auto px-8 lg:px-16">
      <div class="reveal flex items-center gap-4 mb-20">
        <span class="section-label">02 / Work</span>
        <div style="flex: 1; height: 1px; background: rgba(250,250,250,0.1);"></div>
      </div>

      <!-- Featured role -->
      <div
        class="reveal project-card p-10 mb-8"
        style="background: #1a1a1a;"
      >
        <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-6 mb-8">
          <div>
            <div class="section-label mb-3" style="color: #D4A017;">Current</div>
            <h3
              style="
                font-family: 'Cormorant Garamond', serif;
                font-size: clamp(1.6rem, 3vw, 2.5rem);
                font-weight: 400;
                color: #FAFAFA;
                line-height: 1.2;
                margin: 0 0 0.5rem;
              "
            >
              Software Engineering Manager
            </h3>
            <div style="font-size: 1rem; color: #D4A017; font-weight: 400;">
              Cisco Systems Inc.
            </div>
          </div>
          <div
            style="
              font-family: 'JetBrains Mono', monospace;
              font-size: 0.72rem;
              color: #b0b0b0;
              letter-spacing: 0.1em;
              white-space: nowrap;
              padding-top: 0.25rem;
            "
          >
            2022 — PRESENT
          </div>
        </div>

        <div class="rule-gold mb-8" style="width: 2rem;"></div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8" style="color: #b8a894; font-size: 0.95rem; line-height: 1.75;">
          <div>
            <p>
              Leading a full-stack security and software development team focused on Secure Intelligent Services
              across Meraki Dashboard and Cisco Infrastructure. The team owns AI-RRM security hardening, guardrail integration,
              AI-driven security config recommendations, and secure Agentic AI - ensuring robust threat mitigation and safety are built directly into AI-driven network operations.
            </p>
          </div>
          <div>
            <p>
              Beyond shipping secure code, I'm integrating AI security and threat modeling workflows into
              how the team develops software—making secure-by-design AI development a first-class part of the engineering process,
              not just an afterthought.
            </p>
          </div>
        </div>

        <div class="flex flex-wrap gap-2">
          {['Infrastructure Security', 'AI Security', 'Agentic AI', 'Security Architecture', 'People Leadership and Talent Management'].map((skill) => (
            <span
              style="
                font-family: 'JetBrains Mono', monospace;
                font-size: 0.65rem;
                letter-spacing: 0.08em;
                color: #b0b0b0;
                background: rgba(250,250,250,0.05);
                border: 1px solid rgba(250,250,250,0.12);
                padding: 0.25rem 0.65rem;
                border-radius: 1px;
              "
            >
              {skill}
            </span>
          ))}
        </div>
      </div>

      <!-- WatchGuard -->
      <div class="reveal reveal-d2 project-card p-10 mt-8" style="background: #252525;">
        <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-6 mb-8">
          <div>
            <div class="section-label mb-3" style="color: #b8a894;">Previous</div>
            <h3 style="font-family: 'Cormorant Garamond', serif; font-size: clamp(1.4rem, 2.5vw, 2rem); font-weight: 400; color: #E7DED1; line-height: 1.2; margin: 0 0 0.5rem;">
              Engineering Manager | Security Architect
            </h3>
            <div style="font-size: 1rem; color: #D4A017; font-weight: 400;">
              WatchGuard Technologies Inc.
            </div>
          </div>
          <div style="font-family: 'JetBrains Mono', monospace; font-size: 0.72rem; color: #b8a894; letter-spacing: 0.1em; white-space: nowrap; padding-top: 0.25rem;">
            2011 — 2022
          </div>
        </div>

        <div class="rule-gold mb-8" style="width: 2rem;"></div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8" style="color: #b8a894; font-size: 0.95rem; line-height: 1.75;">
          <div>
            <p>
              Led cross-functional teams through the infrastructure transition from on-prem to AWS cloud architecture,
              including the WatchGuard Cloud launch. Enforced Cloud Security and secure SaaS delivery,
              cutting vulnerability risk and customer-reported issues by 60%.
            </p>
          </div>
          <div>
            <p>
              Scaled automated security linting and policy enforcement using Python,
              embedding compliance directly into distributed APIs, UIs, and CI/CD pipelines.
              Governed security architecture for 10+ major releases end-to-end, maintaining zero deployment delays while achieving a 7x growth in automated vulnerability and risk coverage.
            </p>
          </div>
        </div>

        <div class="flex flex-wrap gap-2">
          {['AWS Security', 'Cloud Architecture', 'Python', 'CI/CD', 'MSSP', 'Product Security'].map((skill) => (
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.65rem; letter-spacing: 0.08em; color: #b8a894; background: rgba(250,250,250,0.05); border: 1px solid rgba(250,250,250,0.12); padding: 0.25rem 0.65rem; border-radius: 1px;">
              {skill}
            </span>
          ))}
        </div>
      </div>

      <!-- Earlier experience note -->
      <div class="reveal reveal-d2 flex items-center gap-6 py-6 mt-8" style="color: #888888; border-top: 1px solid rgba(250,250,250,0.08);">
        <div style="width: 2rem; height: 1px; background: #6a5f52; flex-shrink: 0;"></div>
        <p style="font-size: 0.85rem; color: #888888;">Over 18 years in software and security engineering across network, cloud infrastructure, application, system, and AI security.</p>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════
       PROJECTS
  ═══════════════════════════════════════ -->
  <section
    id="projects"
    class="relative py-32"
    style="background: #0a0a0a;"
  >
    <div class="max-w-7xl mx-auto px-8 lg:px-16">
      <div class="reveal flex items-center gap-4 mb-20">
        <span class="section-label">03 / Projects</span>
        <div style="flex: 1; height: 1px; background: rgba(250,250,250,0.1);"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          {
            name: 'Context Infrastructure',
            tag: 'AI · Productivity',
            desc: 'A personal AI workspace system — rules, memory, skills, and agent orchestration patterns that turn Claude into a persistent, context-rich second brain.',
            status: 'Active',
            statusColor: '#9C6B30',
          },
          {
            name: 'AI-RRM',
            tag: 'ML · Networking',
            desc: 'AI-powered Radio Resource Management system for Cisco wireless networks. Applies reinforcement learning to optimize spectrum allocation and reduce interference at scale.',
            status: 'Production',
            statusColor: '#9C6B30',
          },
          {
            name: 'wiyi.ai',
            tag: 'Astro · Design',
            desc: 'This site. Built with Astro, Tailwind v4, and React. Designed as a living portfolio — the code and design are intentional artifacts, not an afterthought.',
            status: 'This Site',
            statusColor: '#b8a894',
          },
          {
            name: 'AI Dev Workflows',
            tag: 'AI · Engineering',
            desc: 'A collection of agentic development workflows integrating Claude Code, parallel subagents, and structured memory into the software engineering process.',
            status: 'Active',
            statusColor: '#9C6B30',
          },
          {
            name: 'Astrophoto Pipeline',
            tag: 'Python · Imaging',
            desc: 'Automated image stacking, calibration, and post-processing pipeline for deep-sky astrophotography. Built to handle raw sensor data from long-exposure sessions.',
            status: 'In Progress',
            statusColor: '#b8a894',
          },
          {
            name: 'Open to Build',
            tag: 'Side Projects',
            desc: 'Actively looking for interesting side projects and business opportunities — especially at the intersection of AI tooling, productivity, and knowledge management.',
            status: 'Exploring',
            statusColor: '#9C6B30',
            isOpen: true,
          },
        ].map(({ name, tag, desc, status, statusColor, isOpen }, i) => (
          <div
            class={`project-card p-8 flex flex-col reveal reveal-d${(i % 3) + 1}`}
            style={`background: #252525; min-height: 260px; ${isOpen ? 'border: 1px solid rgba(156,107,48,0.25);' : ''}`}
          >
            <div class="flex items-start justify-between mb-4">
              <span
                style={`
                  font-family: 'JetBrains Mono', monospace;
                  font-size: 0.65rem;
                  letter-spacing: 0.1em;
                  color: ${statusColor};
                `}
              >
                ● {status}
              </span>
              <span
                style="
                  font-family: 'JetBrains Mono', monospace;
                  font-size: 0.65rem;
                  letter-spacing: 0.08em;
                  color: #888888;
                "
              >
                {tag}
              </span>
            </div>

            <h3
              style="
                font-family: 'Cormorant Garamond', serif;
                font-size: 1.45rem;
                font-weight: 400;
                color: #FAFAFA;
                line-height: 1.2;
                margin: 0 0 1rem;
              "
            >
              {name}
            </h3>

            <p style="font-size: 0.875rem; color: #b8a894; line-height: 1.75; margin: 0; flex: 1;">
              {desc}
            </p>
          </div>
        ))}
      </div>

      <div class="reveal reveal-d4 mt-12 flex justify-center">
        <a
          href="https://github.com/willyiwei"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost"
        >
          More on GitHub →
        </a>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════
       INTERESTS
  ═══════════════════════════════════════ -->
  <section
    id="interests"
    class="relative py-32"
    style="background: #111111;"
  >
    <div class="max-w-7xl mx-auto px-8 lg:px-16">
      <div class="reveal flex items-center gap-4 mb-20">
        <span class="section-label">04 / Beyond the Code</span>
        <div style="flex: 1; height: 1px; background: rgba(250,250,250,0.1);"></div>
      </div>

      <!-- Interest tiles — CSS gradient backgrounds, no external images needed -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" style="grid-auto-rows: 190px;">

        <!-- Running -->
        <div class="reveal reveal-d1 interest-tile" style="height: 190px;
          background:
            radial-gradient(ellipse at 50% 0%, rgba(156, 107, 48, 0.15) 0%, transparent 60%),
            linear-gradient(145deg, #252525 0%, #2a2a2a 100%);"
        >
          <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(26,26,26,0.75) 0%, transparent 100%);"></div>
          <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 1.25rem 1.5rem; z-index: 10;">
            <div class="section-label mb-1" style="color: #D4A017;">Running</div>
            <p style="font-size: 0.78rem; color: #b8a894; margin: 0;">Half marathon finisher. Always training further.</p>
          </div>
        </div>

        <!-- Guitar -->
        <div class="reveal reveal-d2 interest-tile" style="height: 190px;
          background:
            radial-gradient(ellipse at 50% 100%, rgba(156, 107, 48, 0.18) 0%, transparent 55%),
            linear-gradient(160deg, #252525 0%, #2a2a2a 100%);"
        >
          <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(26,26,26,0.75) 0%, transparent 100%);"></div>
          <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 1.25rem 1.5rem; z-index: 10;">
            <div class="section-label mb-1" style="color: #D4A017;">Guitar</div>
            <p style="font-size: 0.78rem; color: #b8a894; margin: 0;">Acoustic and electric. Finding rhythm in the noise.</p>
          </div>
        </div>

        <!-- Travel - spans full row -->
        <div class="reveal reveal-d3 interest-tile md:col-span-3" style="height: 190px;
          background:
            radial-gradient(ellipse at 20% 50%, rgba(156, 107, 48, 0.12) 0%, transparent 50%),
            radial-gradient(ellipse at 80% 60%, rgba(231, 222, 209, 0.08) 0%, transparent 50%),
            linear-gradient(90deg, #252525 0%, #2a2a2a 100%);"
        >
          <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(26,26,26,0.75) 0%, transparent 100%);"></div>
          <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 1.25rem 1.5rem; z-index: 10;">
            <div class="section-label mb-1" style="color: #D4A017;">Travel</div>
            <p style="font-size: 0.78rem; color: #b8a894; margin: 0;">Exploring the world with family — and documenting every moment along the way.</p>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════
       CONTACT
  ═══════════════════════════════════════ -->
  <section
    id="contact"
    class="relative py-40 overflow-hidden"
