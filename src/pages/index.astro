---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- ═══════════════════════════════════════
       NAVIGATION
  ═══════════════════════════════════════ -->
  <nav
    id="main-nav"
    class="fixed top-0 left-0 right-0 z-50 transition-all duration-500"
    style="font-family: 'Outfit', sans-serif;"
  >
    <div class="max-w-7xl mx-auto px-8 lg:px-16 py-6 flex items-center justify-between">
      <!-- Monogram -->
      <a
        href="#hero"
        class="text-xl tracking-tight"
        style="font-family: 'Cormorant Garamond', serif; font-weight: 400; color: #e0e0f0;"
      >
        W<span style="color: #e8a820;">Y</span>
      </a>

      <!-- Links -->
      <div class="hidden md:flex items-center gap-8">
        {[
          { href: '#about', label: 'About' },
          { href: '#work', label: 'Work' },
          { href: '#projects', label: 'Projects' },
          { href: '#interests', label: 'Interests' },
        ].map(({ href, label }) => (
          <a
            href={href}
            class="nav-link text-sm transition-colors duration-200"
            style="color: #8888aa; letter-spacing: 0.04em;"
            onmouseover="this.style.color='#e0e0f0'"
            onmouseout="this.style.color='#8888aa'"
          >
            {label}
          </a>
        ))}
        <a
          href="#contact"
          class="btn-ghost text-sm"
          style="padding: 0.5rem 1.25rem;"
        >
          Connect
        </a>
      </div>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden flex flex-col gap-1.5 p-2"
        aria-label="Menu"
        onclick="document.getElementById('mobile-menu').classList.toggle('hidden')"
      >
        <span class="w-6 h-px block" style="background: #e0e0f0;"></span>
        <span class="w-4 h-px block" style="background: #e0e0f0;"></span>
        <span class="w-6 h-px block" style="background: #e0e0f0;"></span>
      </button>
    </div>

    <!-- Mobile menu -->
    <div
      id="mobile-menu"
      class="hidden md:hidden px-8 pb-6 flex flex-col gap-4"
      style="background: rgba(7, 9, 15, 0.95); backdrop-filter: blur(16px);"
    >
      {['About', 'Work', 'Projects', 'Interests', 'Contact'].map((label) => (
        <a
          href={`#${label.toLowerCase()}`}
          class="text-sm py-2 border-b"
          style="color: #8888aa; border-color: rgba(255,255,255,0.06);"
          onclick="document.getElementById('mobile-menu').classList.add('hidden')"
        >
          {label}
        </a>
      ))}
    </div>
  </nav>


  <!-- ═══════════════════════════════════════
       HERO
  ═══════════════════════════════════════ -->
  <section
    id="hero"
    class="relative min-h-screen flex flex-col justify-center overflow-hidden grain"
    style="padding-top: 6rem; padding-bottom: 6rem;"
  >
    <!-- Starfield canvas -->
    <canvas
      id="starfield"
      class="absolute inset-0 z-0"
      style="pointer-events: none;"
    ></canvas>

    <!-- Nebula gradient layers -->
    <div
      class="absolute inset-0 z-0"
      style="background:
        radial-gradient(ellipse at 75% 25%, rgba(80, 40, 160, 0.14) 0%, transparent 55%),
        radial-gradient(ellipse at 15% 65%, rgba(30, 60, 130, 0.11) 0%, transparent 50%),
        radial-gradient(ellipse at 50% 90%, rgba(232, 168, 32, 0.06) 0%, transparent 45%),
        radial-gradient(ellipse at 90% 80%, rgba(93, 212, 204, 0.04) 0%, transparent 40%),
        #07090f;"
    ></div>

    <!-- Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-8 lg:px-16 w-full">
      <!-- Role label -->
      <div class="reveal reveal-d1 flex items-center gap-4 mb-8">
        <div class="rule-amber" style="width: 2.5rem;"></div>
        <span class="section-label" style="color: #e8a820;">
          AI builder &nbsp;·&nbsp; Engineering Manager &nbsp;·&nbsp; Distance Runner
        </span>
      </div>

      <!-- Name — the centerpiece -->
      <h1
        class="reveal reveal-d2"
        style="
          font-family: 'Cormorant Garamond', serif;
          font-size: clamp(4.5rem, 13vw, 10.5rem);
          font-weight: 400;
          line-height: 0.88;
          letter-spacing: -0.02em;
          color: #e0e0f0;
          margin: 0 0 2rem;
        "
      >
        Will Yi
      </h1>

      <!-- Tagline + location row -->
      <div class="reveal reveal-d3 flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12">
        <p
          style="
            font-family: 'Outfit', sans-serif;
            font-size: clamp(1rem, 2vw, 1.25rem);
            font-weight: 300;
            color: #8888aa;
            max-width: 38rem;
            line-height: 1.65;
            margin: 0;
          "
        >
          Building with AI. Leading with intent.<br />Always learning by doing.<br />
          Software Engineering Manager at Cisco.
        </p>

        <!-- Location badge -->
        <div
          class="flex items-center gap-2 shrink-0"
          style="font-family: 'JetBrains Mono', monospace; font-size: 0.72rem; color: #5dd4cc; letter-spacing: 0.12em;"
        >
          <span style="width: 6px; height: 6px; border-radius: 50%; background: #5dd4cc; display: inline-block;"></span>
          SEATTLE, WA
        </div>
      </div>

      <!-- CTAs -->
      <div class="reveal reveal-d4 flex flex-wrap gap-4 items-center">
        <a href="#work" class="btn-amber">Explore My Work</a>
        <a href="#contact" class="btn-ghost">Let's Connect →</a>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div
      class="absolute bottom-10 right-10 hidden md:flex flex-col items-center gap-3"
      style="opacity: 0.3;"
    >
      <span
        style="
          font-family: 'JetBrains Mono', monospace;
          font-size: 0.65rem;
          letter-spacing: 0.18em;
          color: #e0e0f0;
          writing-mode: vertical-rl;
        "
      >SCROLL</span>
      <div style="width: 1px; height: 4rem; background: linear-gradient(to bottom, #e0e0f0, transparent);"></div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════
       ABOUT
  ═══════════════════════════════════════ -->
  <section
    id="about"
    class="relative py-32"
    style="background: #0d0f1e;"
  >
    <div class="max-w-7xl mx-auto px-8 lg:px-16">
      <!-- Section header -->
      <div class="reveal flex items-center gap-4 mb-20">
        <span class="section-label">01 / About</span>
        <div style="flex: 1; height: 1px; background: rgba(255,255,255,0.07);"></div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-start">
        <!-- Left: big statement -->
        <div>
          <h2
            class="reveal"
            style="
              font-family: 'Cormorant Garamond', serif;
              font-size: clamp(2.2rem, 4.5vw, 3.5rem);
              font-weight: 600;
              line-height: 1.15;
              letter-spacing: -0.01em;
              color: #e0e0f0;
              margin: 0 0 2rem;
            "
          >
            Endlessly curious.<br />
            <span style="color: #e8a820; font-style: italic;">Selectively rigorous.</span><br />
            Always building.
          </h2>

          <div class="rule-amber reveal reveal-d1" style="width: 3rem; margin-bottom: 2rem;"></div>

          <!-- Stats row -->
          <div class="reveal reveal-d2 grid grid-cols-3 gap-6 mb-12">
            {[
              { value: '17+', label: 'Years in Tech' },
              { value: '10+', label: 'Years Leadership' },
              { value: 'Enabler', label: 'Leadership Style' },
            ].map(({ value, label }) => (
              <div>
                <div
                  style="
                    font-family: 'Cormorant Garamond', serif;
                    font-size: 2.2rem;
                    font-weight: 300;
                    color: #e8a820;
                    line-height: 1;
                    margin-bottom: 0.35rem;
                  "
                >
                  {value}
                </div>
                <div style="font-size: 0.75rem; color: #8888aa; letter-spacing: 0.06em;">{label}</div>
              </div>
            ))}
          </div>
        </div>

        <!-- Right: bio -->
        <div class="reveal reveal-d1 flex flex-col gap-5" style="color: #8888aa; font-size: 1rem; line-height: 1.8;">
          <p>
            Engineering Manager at Cisco based in the Greater Seattle Area, focused on developing wireless network intelligence services
            and empowering engineers to do their best work while delivering high-impact outcomes.
          </p>
          <p>
            My approach to leadership is practical: mentorship over directives, deliberate prioritization,
            and keeping the balance between shipping new things and maintaining what already runs in production.
            I'm also building personal AI applications and integrating agentic workflows into how my team works day to day.
          </p>
          <p>
            Outside of work: I run long distances,
            play guitar, and watch or play nearly any sport that involves a ball.
          </p>
          <p>
            Practice is where knowledge becomes skill. That applies to code, leadership, and everything else.
          </p>

          <div class="flex flex-wrap gap-3 mt-4">
            {['AI/LLM Engineering', 'Agentic Architectures', 'Engineering Leadership', 'Project Management', 'Data Analytics', 'Cloud Computing', 'Software Development', 'Network Security'].map((tag) => (
              <span
                style="
                  font-family: 'JetBrains Mono', monospace;
                  font-size: 0.68rem;
                  letter-spacing: 0.08em;
                  color: #5dd4cc;
                  border: 1px solid rgba(93, 212, 204, 0.2);
                  padding: 0.3rem 0.75rem;
                  border-radius: 1px;
                "
              >
                {tag}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════
       WORK / EXPERIENCE
  ═══════════════════════════════════════ -->
  <section
    id="work"
    class="relative py-32"
    style="background: #07090f;"
  >
    <div class="max-w-7xl mx-auto px-8 lg:px-16">
      <div class="reveal flex items-center gap-4 mb-20">
        <span class="section-label">02 / Work</span>
        <div style="flex: 1; height: 1px; background: rgba(255,255,255,0.07);"></div>
      </div>

      <!-- Featured role -->
      <div
        class="reveal project-card p-10 mb-8"
        style="background: #141728;"
      >
        <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-6 mb-8">
          <div>
            <div class="section-label mb-3" style="color: #5dd4cc;">Current</div>
            <h3
              style="
                font-family: 'Cormorant Garamond', serif;
                font-size: clamp(1.6rem, 3vw, 2.5rem);
                font-weight: 400;
                color: #e0e0f0;
                line-height: 1.2;
                margin: 0 0 0.5rem;
              "
            >
              Software Engineering Manager
            </h3>
            <div style="font-size: 1rem; color: #e8a820; font-weight: 400;">
              Cisco — Wireless Intelligent Services
            </div>
          </div>
          <div
            style="
              font-family: 'JetBrains Mono', monospace;
              font-size: 0.72rem;
              color: #8888aa;
              letter-spacing: 0.1em;
              white-space: nowrap;
              padding-top: 0.25rem;
            "
          >
            2022 — PRESENT
          </div>
        </div>

        <div class="rule-amber mb-8" style="width: 2rem;"></div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8" style="color: #8888aa; font-size: 0.95rem; line-height: 1.75;">
          <div>
            <p>
              Leading a full-stack software development team focused on Intelligent Services across
              Meraki Dashboard and Catalyst Center. The team owns AI-RRM, Config Recommendation,
              and Agentic AI — products that bring machine intelligence directly into wireless network operations.
            </p>
          </div>
          <div>
            <p>
              Beyond shipping product, I'm integrating agentic AI workflows into how the team develops software —
              making AI a first-class part of the engineering process, not just the output.
            </p>
          </div>
        </div>

        <div class="flex flex-wrap gap-2">
          {['Python', 'Machine Learning', 'AI Agents', 'LLM Integration', 'System Architecture', 'Team Leadership', 'Wireless Networking'].map((skill) => (
            <span
              style="
                font-family: 'JetBrains Mono', monospace;
                font-size: 0.65rem;
                letter-spacing: 0.08em;
                color: #8888aa;
                background: rgba(255,255,255,0.04);
                border: 1px solid rgba(255,255,255,0.08);
                padding: 0.25rem 0.65rem;
                border-radius: 1px;
              "
            >
              {skill}
            </span>
          ))}
        </div>
      </div>

      <!-- WatchGuard -->
      <div class="reveal reveal-d2 project-card p-10 mt-8" style="background: #141728;">
        <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-6 mb-8">
          <div>
            <div class="section-label mb-3" style="color: #8888aa;">Previous</div>
            <h3 style="font-family: 'Cormorant Garamond', serif; font-size: clamp(1.4rem, 2.5vw, 2rem); font-weight: 400; color: #e0e0f0; line-height: 1.2; margin: 0 0 0.5rem;">
              Software Engineering Manager
            </h3>
            <div style="font-size: 1rem; color: #e8a820; font-weight: 400;">
              WatchGuard Technologies
            </div>
          </div>
          <div style="font-family: 'JetBrains Mono', monospace; font-size: 0.72rem; color: #8888aa; letter-spacing: 0.1em; white-space: nowrap; padding-top: 0.25rem;">
            2011 — 2022
          </div>
        </div>

        <div class="rule-amber mb-8" style="width: 2rem;"></div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8" style="color: #8888aa; font-size: 0.95rem; line-height: 1.75;">
          <div>
            <p>
              Led cross-functional teams through the transition from on-prem to AWS cloud architecture,
              including the WatchGuard Cloud launch. Stabilized firmware and SaaS delivery, cutting
              customer-reported issues by 60%.
            </p>
          </div>
          <div>
            <p>
              Scaled automated test coverage from 10% to 90% — 3,000+ Python/Perl scripts across
              distributed APIs, UIs, and CI/CD pipelines. Managed 10+ major releases end-to-end
              with zero delays and 7x growth in E2E coverage.
            </p>
          </div>
        </div>

        <div class="flex flex-wrap gap-2">
          {['AWS', 'Cloud Architecture', 'Test Automation', 'Python', 'Perl', 'CI/CD', 'SaaS', 'Security'].map((skill) => (
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.65rem; letter-spacing: 0.08em; color: #8888aa; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); padding: 0.25rem 0.65rem; border-radius: 1px;">
              {skill}
            </span>
          ))}
        </div>
      </div>

      <!-- Earlier experience note -->
      <div class="reveal reveal-d2 flex items-center gap-6 py-6 mt-8" style="color: #44446a; border-top: 1px solid rgba(255,255,255,0.05);">
        <div style="width: 2rem; height: 1px; background: #44446a; flex-shrink: 0;"></div>
        <p style="font-size: 0.85rem; color: #44446a;">Over 17 years in software engineering across networking, cloud infrastructure, system design, and AI applications.</p>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════
       PROJECTS
  ═══════════════════════════════════════ -->
  <section
    id="projects"
    class="relative py-32"
    style="background: #0d0f1e;"
  >
    <div class="max-w-7xl mx-auto px-8 lg:px-16">
      <div class="reveal flex items-center gap-4 mb-20">
        <span class="section-label">03 / Projects</span>
        <div style="flex: 1; height: 1px; background: rgba(255,255,255,0.07);"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          {
            name: 'Context Infrastructure',
            tag: 'AI · Productivity',
            desc: 'A personal AI workspace system — rules, memory, skills, and agent orchestration patterns that turn Claude into a persistent, context-rich second brain.',
            status: 'Active',
            statusColor: '#5dd4cc',
          },
          {
            name: 'AI-RRM',
            tag: 'ML · Networking',
            desc: 'AI-powered Radio Resource Management system for Cisco wireless networks. Applies reinforcement learning to optimize spectrum allocation and reduce interference at scale.',
            status: 'Production',
            statusColor: '#e8a820',
          },
          {
            name: 'wiyi.ai',
            tag: 'Astro · Design',
            desc: 'This site. Built with Astro, Tailwind v4, and React. Designed as a living portfolio — the code and design are intentional artifacts, not an afterthought.',
            status: 'This Site',
            statusColor: '#8888aa',
          },
          {
            name: 'AI Dev Workflows',
            tag: 'AI · Engineering',
            desc: 'A collection of agentic development workflows integrating Claude Code, parallel subagents, and structured memory into the software engineering process.',
            status: 'Active',
            statusColor: '#5dd4cc',
          },
          {
            name: 'Astrophoto Pipeline',
            tag: 'Python · Imaging',
            desc: 'Automated image stacking, calibration, and post-processing pipeline for deep-sky astrophotography. Built to handle raw sensor data from long-exposure sessions.',
            status: 'In Progress',
            statusColor: '#8888aa',
          },
          {
            name: 'Open to Build',
            tag: 'Side Projects',
            desc: 'Actively looking for interesting side projects and business opportunities — especially at the intersection of AI tooling, productivity, and knowledge management.',
            status: 'Exploring',
            statusColor: '#e8a820',
            isOpen: true,
          },
        ].map(({ name, tag, desc, status, statusColor, isOpen }, i) => (
          <div
            class={`project-card p-8 flex flex-col reveal reveal-d${(i % 3) + 1}`}
            style={`background: #141728; min-height: 260px; ${isOpen ? 'border: 1px solid rgba(232,168,32,0.2);' : ''}`}
          >
            <div class="flex items-start justify-between mb-4">
              <span
                style={`
                  font-family: 'JetBrains Mono', monospace;
                  font-size: 0.65rem;
                  letter-spacing: 0.1em;
                  color: ${statusColor};
                `}
              >
                ● {status}
              </span>
              <span
                style="
                  font-family: 'JetBrains Mono', monospace;
                  font-size: 0.65rem;
                  letter-spacing: 0.08em;
                  color: #44446a;
                "
              >
                {tag}
              </span>
            </div>

            <h3
              style="
                font-family: 'Cormorant Garamond', serif;
                font-size: 1.45rem;
                font-weight: 400;
                color: #e0e0f0;
                line-height: 1.2;
                margin: 0 0 1rem;
              "
            >
              {name}
            </h3>

            <p style="font-size: 0.875rem; color: #8888aa; line-height: 1.75; margin: 0; flex: 1;">
              {desc}
            </p>
          </div>
        ))}
      </div>

      <div class="reveal reveal-d4 mt-12 flex justify-center">
        <a
          href="https://github.com/willyiwei"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost"
        >
          More on GitHub →
        </a>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════
       INTERESTS
  ═══════════════════════════════════════ -->
  <section
    id="interests"
    class="relative py-32"
    style="background: #07090f;"
  >
    <div class="max-w-7xl mx-auto px-8 lg:px-16">
      <div class="reveal flex items-center gap-4 mb-20">
        <span class="section-label">04 / Beyond the Code</span>
        <div style="flex: 1; height: 1px; background: rgba(255,255,255,0.07);"></div>
      </div>

      <!-- Interest tiles — CSS gradient backgrounds, no external images needed -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" style="grid-auto-rows: 190px;">

        <!-- Running -->
        <div class="reveal reveal-d1 interest-tile" style="height: 190px;
          background:
            radial-gradient(ellipse at 50% 0%, rgba(93, 212, 130, 0.18) 0%, transparent 60%),
            linear-gradient(145deg, #0a1410 0%, #121f14 100%);"
        >
          <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(7,9,15,0.75) 0%, transparent 100%);"></div>
          <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 1.25rem 1.5rem; z-index: 10;">
            <div class="section-label mb-1" style="color: #e8a820;">Running</div>
            <p style="font-size: 0.78rem; color: #8888aa; margin: 0;">Half marathon finisher. Always training further.</p>
          </div>
        </div>

        <!-- Guitar -->
        <div class="reveal reveal-d2 interest-tile" style="height: 190px;
          background:
            radial-gradient(ellipse at 50% 100%, rgba(232, 168, 32, 0.22) 0%, transparent 55%),
            linear-gradient(160deg, #130e08 0%, #1a1208 100%);"
        >
          <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(7,9,15,0.75) 0%, transparent 100%);"></div>
          <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 1.25rem 1.5rem; z-index: 10;">
            <div class="section-label mb-1" style="color: #e8a820;">Guitar</div>
            <p style="font-size: 0.78rem; color: #8888aa; margin: 0;">Acoustic and electric. Finding rhythm in the noise.</p>
          </div>
        </div>

        <!-- Travel - spans full row -->
        <div class="reveal reveal-d3 interest-tile md:col-span-3" style="height: 190px;
          background:
            radial-gradient(ellipse at 20% 50%, rgba(93, 160, 232, 0.14) 0%, transparent 50%),
            radial-gradient(ellipse at 80% 60%, rgba(93, 212, 180, 0.1) 0%, transparent 50%),
            linear-gradient(90deg, #090e14 0%, #0a1018 100%);"
        >
          <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(7,9,15,0.75) 0%, transparent 100%);"></div>
          <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 1.25rem 1.5rem; z-index: 10;">
            <div class="section-label mb-1" style="color: #e8a820;">Travel</div>
            <p style="font-size: 0.78rem; color: #8888aa; margin: 0;">Exploring the world with family — and documenting every moment along the way.</p>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════
       CONTACT
  ═══════════════════════════════════════ -->
  <section
    id="contact"
    class="relative py-40 overflow-hidden"
    style="background: #07090f;"
  >
    <!-- Background glow -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="background: radial-gradient(ellipse at 50% 100%, rgba(232,168,32,0.07) 0%, transparent 60%);"
    ></div>

    <div class="relative z-10 max-w-7xl mx-auto px-8 lg:px-16 text-center">
      <div class="reveal flex items-center gap-4 mb-20 justify-center">
        <div style="flex: 1; max-width: 4rem; height: 1px; background: rgba(255,255,255,0.07);"></div>
        <span class="section-label">05 / Let's Talk</span>
        <div style="flex: 1; max-width: 4rem; height: 1px; background: rgba(255,255,255,0.07);"></div>
      </div>

      <h2
        class="reveal"
        style="
          font-family: 'Cormorant Garamond', serif;
          font-size: clamp(2.5rem, 6vw, 5rem);
          font-weight: 300;
          line-height: 1.1;
          letter-spacing: -0.02em;
          color: #e0e0f0;
          margin: 0 0 1.5rem;
        "
      >
        Open to great opportunities<br />
